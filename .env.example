# Copy to .env and fill real values. Local dev values live in docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://shuddha:shuddha@localhost:5436/shuddha?schema=public"

# ---- Auth (ADR-0008) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_LENGTH=6
FRONTEND_URL=http://localhost:3000
# Extra allowed CORS origins (comma-separated, no trailing slash). Enforced only
# when NODE_ENV=production. e.g. https://suddh-bharat-frontend-production.up.railway.app
CORS_ORIGINS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# ---- Payments — Razorpay (ADR-0011) ----
# Live-only: /payment/initiate + /verify require these. Get test keys from the
# Razorpay dashboard (test mode). key_secret is server-only, never sent to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Shipping — Shiprocket (ADR-0011) ----
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Shared secret you set when registering the tracking webhook (X-Shiprocket-Token).
SHIPROCKET_WEBHOOK_SECRET=
# Must match a pickup nickname configured in the Shiprocket panel.
SHIPROCKET_PICKUP_LOCATION=Primary

# ---- Store pickup / warehouse (Shiprocket source address) ----
STORE_PICKUP_NAME=Shuddha Bharat
STORE_PICKUP_PHONE=
STORE_PICKUP_ADDRESS=
STORE_PICKUP_CITY=
STORE_PICKUP_STATE=
STORE_PICKUP_PINCODE=
STORE_PICKUP_COUNTRY=India

# ---- Shipping / COD policy (integer paise; empty threshold = never free) ----
STORE_FREE_SHIPPING_THRESHOLD_MINOR=49900
STORE_SHIPPING_FEE_MINOR=4900
STORE_COD_ENABLED=true
STORE_COD_CHARGE_MINOR=0
STORE_MIN_ORDER_MINOR=0

# ---- Scale / security ----
OTP_DEBUG=false                # dev-only: echo the OTP in the response/logs. Keep false in prod.
REDIS_URL=                     # set → throttler uses a shared Redis store (real limits across instances)
REVALIDATE_SECRET=       # shared with the frontend /api/revalidate route (cache busting)

# Razorpay dashboard webhook secret (HMAC verify for POST /webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET=
