# Copy to .env and fill real values. Local dev values live in docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://shuddha:shuddha@localhost:5436/shuddha?schema=public"

# ---- Auth (ADR-0008) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_LENGTH=6
FRONTEND_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
